{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(node *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(rm --recursive *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.staging)",
      "Read(.env.test)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "skillOverrides": {
    "api-design": "off",
    "db-migrations": "off",
    "security-checklist": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-env-read.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-env-commit.sh"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/pullim/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/auto-format.sh"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/pullim/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/pullim/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/pullim/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/pullim/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/pullim/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/pullim/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/pullim/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/pullim/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/pullim/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/pullim/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 /Users/pullim/.claude/statusline-command.py"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true
}
